{
  "expo": {
    "name": "pokebo",
    "slug": "pokebo",
    "version": "0.1.0",
    "android": {
      "package": "com.pokebo.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F3F5FB"
      }
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Pokebo usa la cámara para sacar la foto del animal que querés capturar.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Pokebo usa tu ubicación para registrar capturas y avisarte sobre avistamientos cercanos mientras usás la app.",
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      "expo-notifications",
      "expo-font"
    ],
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light"
  }
}
