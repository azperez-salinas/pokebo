# Reemplazá la IP por la de tu computadora en la red Wi-Fi.
# El teléfono no puede acceder al Edge API mediante localhost.
EXPO_PUBLIC_API_URL=http://192.168.1.100:3000

cd ..# Se usa solamente al generar el proyecto nativo de Android.
# No uses el prefijo EXPO_PUBLIC_ y no guardes el valor real en Git.
GOOGLE_MAPS_API_KEY=
