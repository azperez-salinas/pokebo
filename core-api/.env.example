# Puerto HTTP del Core API (solo accesible desde la red secure)
PORT=4000

# Clave PRIVADA para firmar JWT (PEM con \n escapados) - valor de ejemplo
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREEMPLAZAR\n-----END PRIVATE KEY-----"

# Clave PUBLICA correspondiente a JWT_PRIVATE_KEY, para verificar JWT (PEM con \n escapados) - valor de ejemplo
# Si se omite, el Core la deriva de la privada
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nREEMPLAZAR\n-----END PUBLIC KEY-----"

# Secreto compartido Edge <-> Core para verificar la firma HMAC - debe coincidir con el Edge
SERVICE_SHARED_SECRET=reemplazar-por-secreto-largo-aleatorio

# Conexiones (hosts de docker-compose, sin credenciales reales)
MONGO_URI=mongodb://mongo:27017/pokebo
REDIS_URI=redis://redis:6379

# Envío de mails: "console" (mock que loguea en consola) es el único valor soportado por ahora.
# En producción se reemplazaría por un proveedor real.
MAIL_PROVIDER=console
