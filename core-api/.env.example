# Puerto HTTP del Core API (solo accesible desde la red secure)
PORT=4000

# Clave PRIVADA para firmar JWT (PEM con \n escapados) - valor de ejemplo
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREEMPLAZAR\n-----END PRIVATE KEY-----"


# Conexiones (hosts de docker-compose, sin credenciales reales)
MONGO_URI=mongodb://mongo:27017/pokebo
REDIS_URI=redis://redis:6379

# Publicación de OTP en SQS. En AWS la identidad de la tarea aporta credenciales temporales.
AWS_REGION=us-east-2
OTP_EMAIL_QUEUE_URL=https://sqs.us-east-2.amazonaws.com/000000000000/pokebo-demo-otp-email
# Piso de tiempo para que la latencia no revele si se publicó un correo.
OTP_RESPONSE_MIN_MS=1000

# Registro con verificación por correo. El pepper debe ser largo, aleatorio y distinto de la clave JWT.
REGISTRATION_CODE_PEPPER=reemplazar-por-pepper-largo-aleatorio
REGISTRATION_CODE_TTL=300
REGISTRATION_RESEND_COOLDOWN=60
REGISTRATION_MAX_ATTEMPTS=5
REGISTRATION_MAX_RESENDS=3

# Segundo factor al iniciar sesión. Usar un pepper diferente del registro y de la clave JWT.
LOGIN_CODE_PEPPER=reemplazar-por-otro-pepper-largo-aleatorio
LOGIN_CODE_TTL=300
LOGIN_RESEND_COOLDOWN=60
LOGIN_MAX_ATTEMPTS=5
LOGIN_MAX_RESENDS=3

# Identificación síncrona de imágenes. En AWS la clave se obtiene desde Secrets Manager.
AI_PROVIDER_API_KEY=reemplazar-por-api-key-real
AI_MODEL=gemini-3.5-flash-lite
