# Puerto HTTP del Edge API
PORT=3000

# URL interna del Core API (red secure)
CORE_API_URL=http://core-api:4000

# Clave PUBLICA para verificar JWT (PEM con \n escapados) - valor de ejemplo
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nREEMPLAZAR\n-----END PUBLIC KEY-----"

# Secreto compartido Edge <-> Core para firmar requests (HMAC) - debe coincidir con el Core
SERVICE_SHARED_SECRET=reemplazar-por-secreto-largo-aleatorio

# API key del proveedor de IA de identificación
AI_PROVIDER_API_KEY=pendiente-de-reemplazar-por-api-key-real

# Modelo de Gemini con visión usado para identificar la especie (la API key es la de Google AI Studio)
AI_MODEL=gemini-3.5-flash-lite

# Credenciales de Firebase (FCM): ruta al JSON o JSON inline
FIREBASE_CREDENTIALS=pendiente-de-reemplazar
